# From Supabase Project Settings -> Data API (safe for browser & server)
SUPABASE_URL=

# From Supabase Project Settings -> API Keys (safe for browser)
SUPABASE_PUBLISHABLE_KEY=

# From Supabase Project Settings -> API Keys (server-only, bypasses RLS)
SUPABASE_SECRET_KEY=

# From Google AI Studio -> Get API Key (server-only)
GEMINI_API_KEY=

# Google Gemini model name for speech parsing and generation
GEMINI_MODEL=gemini-3.1-flash-lite
